<Window x:Class="FileGrid.Portable.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="520" Width="420" WindowStartupLocation="CenterOwner">
  <ScrollViewer Margin="12">
    <StackPanel>
      <TextBlock Text="Appearance" FontWeight="Bold" Margin="0,0,0,8" />
      <TextBlock Text="Text scale" />
      <Slider x:Name="TextScale" Minimum="0.65" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" />
      <CheckBox x:Name="ShowPath" Content="Show file path on boxes" Margin="0,8,0,0" />
      <CheckBox x:Name="ShowGrid" Content="Show alignment grid" Margin="0,4,0,0" />
      <TextBlock Text="Background (#rrggbb)" Margin="0,8,0,0" />
      <TextBox x:Name="BgColor" />
      <TextBlock Text="Grid color (#rrggbb)" Margin="0,8,0,0" />
      <TextBox x:Name="GridColor" />
      <TextBlock Text="Grid opacity" Margin="0,8,0,0" />
      <Slider x:Name="GridOpacity" Minimum="0.05" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" />
      <TextBlock Text="Font family" Margin="0,8,0,0" />
      <ComboBox x:Name="FontFamilyBox" IsEditable="True" />
      <TextBlock Text="Font color (#rrggbb)" Margin="0,8,0,0" />
      <TextBox x:Name="FontColor" />
      <Separator Margin="0,16,0,16" />
      <TextBlock Text="Layout" FontWeight="Bold" Margin="0,0,0,8" />
      <TextBlock Text="Rename layout" />
      <TextBox x:Name="LayoutName" Margin="0,0,0,8" />
      <Button Content="Save layout name" Click="SaveName_Click" HorizontalAlignment="Left" />
      <TextBlock Text="Duplicate as" Margin="0,12,0,0" />
      <TextBox x:Name="DuplicateName" Margin="0,0,0,8" />
      <Button Content="Duplicate layout" Click="Duplicate_Click" HorizontalAlignment="Left" />
      <Button Content="Done" Margin="0,20,0,0" Width="100" HorizontalAlignment="Right" IsDefault="True" Click="Done_Click" />
    </StackPanel>
  </ScrollViewer>
</Window>
