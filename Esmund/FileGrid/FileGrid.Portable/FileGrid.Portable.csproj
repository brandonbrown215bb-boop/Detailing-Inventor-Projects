<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon />
    <AssemblyName>FileGrid</AssemblyName>
    <RootNamespace>FileGrid.Portable</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Portable Windows build of File Grid (companion to the Electron app)</Description>
  </PropertyGroup>
</Project>
