<Window x:Class="UnitProgressTracker.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UnitProgressTracker.Wpf.Controls"
        xmlns:local="clr-namespace:UnitProgressTracker.Wpf"
        Title="{Binding WindowTitle}"
        Height="900" Width="1440" MinHeight="640" MinWidth="1024"
        Background="{StaticResource BgDarkBrush}"
        Closing="OnWindowClosing">

    <Window.Resources>
        <local:ColorHexToBrushConverter x:Key="HexToBrushConverter" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:BoolToVisibilityTextConverter x:Key="BoolToVisibilityTextConverter" />
        <local:BoolToVisibilityToggleConverter x:Key="BoolToVisibilityToggleConverter" />
        <local:IntToBoolConverter x:Key="IntToBoolConverter" />
        <local:TabToVisibilityConverter x:Key="TabToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main Menu Bar -->
        <Menu Grid.Row="0" Background="{StaticResource HeaderBgBrush}" Foreground="{StaticResource TextMainBrush}" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Open Project..." Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Open Folder..." Click="OnOpenFolderClick" />
                <Separator />
                <MenuItem Header="_Save Project" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save Project _As..." Command="{Binding SaveProjectAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Recent _Projects" ItemsSource="{Binding RecentProjects}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding DisplayName}" />
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                            <Setter Property="CommandParameter" Value="{Binding FilePath}" />
                            <Setter Property="ToolTip" Value="{Binding FilePath}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="Clear Recent Projects" Command="{Binding ClearRecentProjectsCommand}" IsEnabled="{Binding HasRecentProjects}" />
                <Separator />
                <MenuItem Header="Import _Excel BOM..." Command="{Binding ImportExcelBomCommand}" />
                <MenuItem Header="Export _Audit Report (Markdown)..." Command="{Binding ExportMarkdownCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" InputGestureText="Alt+F4" />
            </MenuItem>
            
            <MenuItem Header="_View">
                <MenuItem Header="_3D Surfaces" Click="OnSurfacesTabClick" />
                <MenuItem Header="_BOM Shell Export" Click="OnBomTabClick" />
                <Separator />
                <MenuItem Header="Toggle _Wireframe" Command="{Binding ToggleWireframeCommand}" />
                <MenuItem Header="_Fit View" Click="OnFitViewClick" />
                <MenuItem Header="_Reset Camera" Click="OnResetCameraClick" />
            </MenuItem>
        </Menu>

        <!-- Secondary Action Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource HeaderBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="12,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Unit Progress Tracker" Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <Button Content="Open Folder..." Click="OnOpenFolderClick" Margin="0,0,6,0" />
                    <Button Content="Rescan" Click="OnRescanClick" Margin="0,0,6,0" />
                    <Button Content="⟳ Async Scan" Command="{Binding AsyncScanFolderCommand}" IsEnabled="{Binding IsNotScanning}" Margin="0,0,6,0" />
                    <Button Content="✕ Cancel" Command="{Binding CancelScanCommand}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,6,0" />
                    <Button Content="Load Demo Data" Click="OnLoadDemoDataClick" Margin="0,0,16,0" />
                    <Button Content="Export Audit MD" Command="{Binding ExportMarkdownCommand}" Margin="0,0,6,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <RadioButton Content="3D Surfaces" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6" Margin="0,0,4,0" Click="OnSurfacesTabClick" />
                    <RadioButton Content="BOM Shell Export" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6" Click="OnBomTabClick" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="340" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel (Surfaces / BOM List) -->
            <Border Grid.Column="0" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <!-- Surfaces List View -->
                    <DockPanel Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabToVisibilityConverter}, ConverterParameter=0}">
                        <Border DockPanel.Dock="Top" Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>

                        <ListBox ItemsSource="{Binding Surfaces}" SelectedItem="{Binding SelectedSurface}" Background="Transparent" BorderThickness="0" Margin="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Margin="2" CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1f2937" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                        <Setter Property="Background" Value="#111827" />
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Background="#0f172a" BorderBrush="#38bdf8" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding ShortLabel}" Foreground="#38bdf8" FontFamily="Consolas" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                            </Border>
                                            <Button DockPanel.Dock="Right" Content="{Binding IsHidden, Converter={StaticResource BoolToVisibilityTextConverter}}" Command="{Binding DataContext.ToggleSurfaceVisibilityCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="4,0,0,0" Padding="4,2" FontSize="10" ToolTip="Toggle Visibility" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SurfaceNumber}" Foreground="{StaticResource TextMainBrush}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="{Binding SurfaceUnitSide}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- BOM Shell Entries View -->
                    <DockPanel Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabToVisibilityConverter}, ConverterParameter=1}">
                        <Border DockPanel.Dock="Top" Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="#0f172a">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Shell Root:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" />
                                    <Button Content="Change..." Click="OnSetShellRootClick" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="6,2" />
                                    <TextBox Text="{Binding ShellRootPath}" IsReadOnly="True" VerticalAlignment="Center" Background="#1f2937" />
                                </DockPanel>

                                <DockPanel Margin="0,0,0,6">
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="140" DockPanel.Dock="Left" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding AvailableSkids}" SelectedItem="{Binding SelectedSkidFilter}" Width="110" DockPanel.Dock="Right" />
                                </DockPanel>

                                <DockPanel Margin="0,0,0,6">
                                    <ComboBox ItemsSource="{Binding AvailableSegments}" SelectedItem="{Binding SelectedSegmentFilter}" Width="110" DockPanel.Dock="Right" />
                                    <CheckBox Content="SQ Custom Doors Only" IsChecked="{Binding IsCustomSqOnly}" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center" FontSize="11" />
                                </DockPanel>

                                <DockPanel>
                                    <Button Content="Import Excel BOM" Command="{Binding ImportExcelBomCommand}" Margin="0,0,4,0" Padding="6,4" />
                                    <Button Content="+ Add" Command="{Binding AddBomRowCommand}" Margin="0,0,4,0" Padding="6,4" />
                                    <Button Content="- Delete" Command="{Binding DeleteBomRowCommand}" Margin="0,0,4,0" Padding="6,4" />
                                    <Button Content="Export Folders" Click="OnCreateShellFoldersClick" Background="#0284c7" Foreground="White" FontWeight="Bold" Padding="8,4" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border DockPanel.Dock="Top" Visibility="{Binding HasMisplacedCoilPanels, Converter={StaticResource BoolToVisibilityConverter}}" Background="#451a03" BorderBrush="#f59e0b" BorderThickness="0,0,0,1" Padding="8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="⚠️ Misplaced Coil Lines" Foreground="#fbbf24" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button Content="{Binding MisplacedDetailsToggleText}" Command="{Binding ToggleMisplacedDetailsCommand}" DockPanel.Dock="Right" Padding="6,2" FontSize="10" />
                                </DockPanel>
                                <TextBlock Text="{Binding MisplacedCoilPanelMessage}" Foreground="#fef3c7" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <DataGrid ItemsSource="{Binding FilteredBomEntries}" SelectedItem="{Binding SelectedBomEntry}" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1e293b" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Part Number" Binding="{Binding PartNumber}" Width="100" />
                                <DataGridTextColumn Header="Skid" Binding="{Binding Skid}" Width="80" />
                                <DataGridTextColumn Header="Seg" Binding="{Binding Segment}" Width="45" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="35" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                <DataGridTextColumn Header="Relative Path" Binding="{Binding RelativePath}" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Center Viewport (HelixToolkit 3D Surface Viewport) -->
            <Border Grid.Column="2" Background="#020617">
                <Grid>
                    <controls:Surface3DViewport x:Name="Viewport3D" />

                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="8,6" Background="#800f172a" CornerRadius="6" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Opacity:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Slider Width="80" Minimum="0.1" Maximum="1.0" Value="{Binding GlobalOpacity, Mode=TwoWay}" ValueChanged="OnOpacitySliderChanged" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ToggleButton Content="Wireframe" IsChecked="{Binding WireframeVisible, Mode=TwoWay}" Padding="6,2" FontSize="11" Margin="0,0,6,0" />
                            <Button Content="Fit View" Click="OnFitViewClick" Padding="6,2" FontSize="11" Margin="0,0,4,0" />
                            <Button Content="Reset Camera" Click="OnResetCameraClick" Padding="6,2" FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Right Detail Panel (Status & Interactive Checklist) -->
            <Border Grid.Column="4" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16" IsEnabled="{Binding HasSelectedSurface}">
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Surface Details" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Content="{Binding SelectedSurface.IsHidden, Converter={StaticResource BoolToVisibilityToggleConverter}}" Command="{Binding ToggleSelectedSurfaceVisibilityCommand}" DockPanel.Dock="Right" Padding="6,2" FontSize="10" />
                        </DockPanel>

                        <TextBlock Text="Surface Number" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding SelectedSurface.SurfaceNumber}" Foreground="{StaticResource TextMainBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

                        <TextBlock Text="Unit Side" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding SelectedSurface.SurfaceUnitSide}" Foreground="{StaticResource TextMainBrush}" FontSize="13" Margin="0,0,0,12" />

                        <!-- Status State Selector with Manage Button -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Status State" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                            <Button Content="⚙ Manage..." Command="{Binding ManageStatusStatesCommand}" DockPanel.Dock="Right" Padding="4,1" FontSize="10" />
                        </DockPanel>
                        <ComboBox x:Name="StatusComboBox" ItemsSource="{Binding StatusStates}" SelectedValue="{Binding SelectedSurface.StateId, Mode=OneWay}" SelectedValuePath="Id" SelectionChanged="OnStatusSelectionChanged" Margin="0,0,0,16">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16" />

                        <!-- Interactive Audit Checklist -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Audit Checklist" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ChecklistProgressText}" Foreground="{StaticResource AccentBrush}" FontSize="10" VerticalAlignment="Center" DockPanel.Dock="Right" />
                        </DockPanel>

                        <ProgressBar Value="{Binding ChecklistProgressPercent, Mode=OneWay}" Height="4" Background="#1e293b" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />

                        <ItemsControl ItemsSource="{Binding ChecklistItems}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1e293b" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                        <DockPanel>
                                            <Button Content="✕" Command="{Binding DataContext.DeleteChecklistItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Key}" DockPanel.Dock="Right" Padding="4,0" FontSize="10" Foreground="#ef4444" Background="Transparent" BorderThickness="0" ToolTip="Delete Item" />
                                            <CheckBox Content="{Binding Key}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add Checklist Item Box -->
                        <Border Background="#1f2937" Padding="6" CornerRadius="4" Margin="0,0,0,16">
                            <DockPanel>
                                <Button Content="+ Add Item" Click="OnAddChecklistItemClick" DockPanel.Dock="Right" Padding="6,2" FontSize="11" Margin="6,0,0,0" />
                                <TextBox x:Name="NewChecklistItemBox" KeyDown="OnNewChecklistItemKeyDown" />
                            </DockPanel>
                        </Border>

                        <!-- Multiline Notes Editor -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Notes" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                            <Button Content="Clear" Command="{Binding ClearNotesCommand}" DockPanel.Dock="Right" Padding="4,1" FontSize="10" />
                        </DockPanel>
                        <TextBox Text="{Binding SelectedSurfaceNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" MinHeight="100" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource HeaderBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
        </Border>

        <!-- Modal Progress Overlay for Async IAM Scan (Milestone M4) -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="1000"
              Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#CC0F172A">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="500" Padding="28,24" Background="#1E293B"
                    BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#38BDF8" Opacity="0.3" />
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="⚡ Scanning Unit IAM Geometry..."
                                   Foreground="#F8FAFC" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ScanProgress, StringFormat='{}{0:F0}%'}"
                                   Foreground="#38BDF8" FontWeight="Bold" FontSize="16" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                    </DockPanel>

                    <ProgressBar Value="{Binding ScanProgress}" Minimum="0" Maximum="100"
                                 Height="16" Margin="0,0,0,12"
                                 Foreground="#38BDF8" Background="#0F172A" />

                    <TextBlock Text="{Binding ScanProgressLabel}"
                               Foreground="#94A3B8" FontSize="12"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,20" />

                    <Button Content="✕ Cancel Scan" Command="{Binding CancelScanCommand}"
                            HorizontalAlignment="Right" Padding="18,8"
                            Background="#DC2626" Foreground="White" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
