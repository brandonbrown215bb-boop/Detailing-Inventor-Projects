<Window x:Class="UnitProgressTracker.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UnitProgressTracker.Wpf.Controls"
        Title="Unit Progress Tracker — Native C# WPF v1.1.0"
        Height="900" Width="1440" MinHeight="640" MinWidth="1024"
        Background="{StaticResource BgDarkBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Navigation -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Unit Progress Tracker" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <Button Content="Open Folder..." Click="OnOpenFolderClick" Margin="0,0,6,0" />
                    <Button Content="Rescan" Click="OnRescanClick" Margin="0,0,6,0" />
                    <Button Content="⟳ Async Scan" Command="{Binding AsyncScanFolderCommand}" IsEnabled="{Binding IsNotScanning}" Margin="0,0,6,0" />
                    <Button Content="✕ Cancel" Command="{Binding CancelScanCommand}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,6,0" />
                    <Button Content="Load Demo Data" Click="OnLoadDemoDataClick" Margin="0,0,16,0" />
                    <Button Content="Export Audit MD" Command="{Binding ExportMarkdownCommand}" Margin="0,0,6,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <RadioButton Content="3D Surfaces" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6" Margin="0,0,4,0" Click="OnSurfacesTabClick" />
                    <RadioButton Content="BOM Shell Export" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6" Click="OnBomTabClick" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="320" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel (Surfaces / BOM List) -->
            <Border Grid.Column="0" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <!-- Surfaces List View -->
                    <DockPanel Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabToVisibilityConverter}, ConverterParameter=0}">
                        <Border DockPanel.Dock="Top" Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>

                        <ListBox ItemsSource="{Binding Surfaces}" SelectedItem="{Binding SelectedSurface}" Background="Transparent" BorderThickness="0" Margin="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Margin="2" Background="#1f2937" CornerRadius="4">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Background="#0f172a" BorderBrush="#38bdf8" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding ShortLabel}" Foreground="#38bdf8" FontFamily="Consolas" FontWeight="Bold" FontSize="11" />
                                            </Border>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="{Binding IsHidden, Converter={StaticResource BoolToVisibilityTextConverter}}"
                                                        Command="{Binding DataContext.ToggleSurfaceVisibilityCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        FontSize="10" Padding="4,1" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SurfaceNumber}" Foreground="#f8fafc" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{Binding SurfaceUnitSide}" Foreground="#94a3b8" FontSize="11" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- BOM Export View -->
                    <DockPanel Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabToVisibilityConverter}, ConverterParameter=1}">
                        <!-- Top Action Toolbar -->
                        <Border DockPanel.Dock="Top" Padding="8" Background="{StaticResource HeaderBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button Content="Import Excel BOM..." Command="{Binding ImportExcelBomCommand}" Margin="0,0,6,0" />
                                    <Button Content="Set Shell Root Folder..." Command="{Binding SetShellRootFolderCommand}" Margin="0,0,6,0" />
                                    <Button Content="Create Shell Folders" Command="{Binding CreateShellFoldersCommand}" Background="#0284c7" Foreground="White" Margin="0,0,6,0" />
                                    <Button Content="Open Folder" Command="{Binding OpenShellFolderCommand}" Margin="0,0,12,0" />
                                    <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="0,2,12,2" />
                                    <Button Content="+ Add Row" Command="{Binding AddBomRowCommand}" Margin="0,0,4,0" />
                                    <Button Content="- Delete Row" Command="{Binding DeleteBomRowCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ShellRootPath}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                            </DockPanel>
                        </Border>

                        <!-- Red Alert Banner for Misplaced Coil Panels -->
                        <Border DockPanel.Dock="Top" Visibility="{Binding HasMisplacedCoilPanels, Converter={StaticResource BoolToVisibilityConverter}}" Background="#7f1d1d" BorderBrush="#ef4444" BorderThickness="0,0,0,1" Padding="10,6">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{Binding MisplacedDetailsToggleText}" Command="{Binding ToggleMisplacedDetailsCommand}" Padding="6,2" FontSize="11" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚠️ MISPLACED COIL PANEL ALERT: " Foreground="#fca5a5" FontWeight="Bold" FontSize="12" />
                                    <TextBlock Text="{Binding MisplacedCoilPanelMessage}" Foreground="#fee2e2" FontSize="12" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Filter Control Bar -->
                        <Border DockPanel.Dock="Top" Padding="8,6" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableSkids}" SelectedItem="{Binding SelectedSkidFilter}" Width="130" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableSegments}" SelectedItem="{Binding SelectedSegmentFilter}" Width="120" Margin="0,0,8,0" />
                                <CheckBox Grid.Column="3" Content="SQ Custom Only" IsChecked="{Binding IsCustomSqOnly}" VerticalAlignment="Center" Foreground="{StaticResource TextMainBrush}" />
                            </Grid>
                        </Border>

                        <!-- DataGrid Component -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <DataGrid x:Name="BomDataGrid"
                                      ItemsSource="{Binding FilteredBomEntries}"
                                      SelectedItem="{Binding SelectedBomEntry}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="True"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#1f2937"
                                      HeadersVisibility="Column"
                                      Background="Transparent"
                                      RowHeaderWidth="0">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="#111827" />
                                        <Setter Property="Foreground" Value="#f8fafc" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCustomSq}" Value="True">
                                                <Setter Property="Background" Value="#3b2d00" />
                                                <Setter Property="BorderBrush" Value="#f59e0b" />
                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1f2937" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#0284c7" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Part Number" Binding="{Binding PartNumber}" Width="110" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="45" />
                                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="45" />
                                    <DataGridTextColumn Header="Skid" Binding="{Binding Skid}" Width="110" />
                                    <DataGridTextColumn Header="Segment" Binding="{Binding Segment}" Width="75" />
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="160" />
                                    <DataGridTextColumn Header="Ext Description" Binding="{Binding ExtDescription}" Width="140" />
                                    <DataGridTemplateColumn Header="Shell Folder Path" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RelativePath}" Foreground="#38bdf8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Tag" Width="75">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Visibility="{Binding IsCustomSq, Converter={StaticResource BoolToVisibilityConverter}}" Background="#f59e0b" Padding="4,1" CornerRadius="2" HorizontalAlignment="Center">
                                                    <TextBlock Text="SQ CUSTOM" Foreground="Black" FontSize="9" FontWeight="Bold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Splitter 1 -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#1f2937" />

            <!-- Center Viewport -->
            <Grid Grid.Column="2">
                <controls:Surface3DViewport x:Name="Viewport3D" />

                <!-- Scan Progress Overlay -->
                <Border Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="#CC0b0f19" VerticalAlignment="Bottom" Padding="16,10" Margin="0,0,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ScanProgress, StringFormat={}{0:F0}%}" Foreground="#38bdf8" FontSize="12" FontFamily="Consolas" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding ScanProgressLabel}" Foreground="#94a3b8" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ProgressBar Value="{Binding ScanProgress}" Minimum="0" Maximum="100" Height="6"
                                     Foreground="#38bdf8" Background="#1f2937" />
                    </StackPanel>
                </Border>

                <!-- Viewport Overlay Toolbar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
                    <Button Content="Fit View" Click="OnFitViewClick" />
                    <Button Content="Reset Camera" Click="OnResetCameraClick" Margin="6,0,0,0" />
                    <Button Content="{Binding WireframeVisible, Converter={StaticResource BoolToWireframeLabelConverter}}"
                            Command="{Binding ToggleWireframeCommand}" Margin="6,0,0,0" />
                    <!-- Opacity slider -->
                    <Border Background="#CC0b0f19" CornerRadius="4" Padding="8,4" Margin="6,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Opacity" Foreground="#94a3b8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" Value="{Binding GlobalOpacity, Mode=TwoWay}"
                                    Width="90" VerticalAlignment="Center"
                                    ValueChanged="OnOpacitySliderChanged" />
                            <TextBlock Text="{Binding GlobalOpacity, StringFormat={}{0:P0}}" Foreground="#38bdf8" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Splitter 2 -->
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#1f2937" />

            <!-- Right Detail Drawer -->
            <Border Grid.Column="4" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedSurface}">
                        <TextBlock Text="Surface Details" Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />

                        <TextBlock Text="Surface Number" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                        <TextBlock Text="{Binding SurfaceNumber}" Foreground="{StaticResource TextMainBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SurfaceUnitSide}" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,12" />

                        <TextBlock Text="Status State" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <ComboBox x:Name="StatusComboBox"
                                  ItemsSource="{Binding DataContext.StatusStates, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectionChanged="OnStatusSelectionChanged"
                                  Margin="0,0,0,12" />

                        <!-- Visibility toggle -->
                        <Button Content="{Binding IsHidden, Converter={StaticResource BoolToVisibilityToggleConverter}}"
                                Command="{Binding DataContext.ToggleSurfaceVisibilityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding DataContext.SelectedSurface, RelativeSource={RelativeSource AncestorType=Window}}"
                                HorizontalAlignment="Left" Margin="0,0,0,16" />

                        <!-- Dynamic checklist bound to model -->
                        <TextBlock Text="Checklist" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding DataContext.ChecklistItems, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Key}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Foreground="#f8fafc" Margin="0,0,0,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add checklist item -->
                        <Border Margin="0,8,0,16" Padding="6" Background="#1f2937" CornerRadius="4">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="+ Add" Click="OnAddChecklistItemClick" Padding="6,2" Margin="6,0,0,0" />
                                <TextBox x:Name="NewChecklistItemBox" />
                            </DockPanel>
                        </Border>

                        <TextBlock Text="Notes" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="100" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource HeaderBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
        </Border>
    </Grid>
</Window>
