<Window x:Class="UnitProgressTracker.Wpf.StatusStateEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UnitProgressTracker.Wpf"
        Title="Status State Manager"
        Height="520" Width="680" MinHeight="450" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextMainBrush}">

    <Window.Resources>
        <local:ColorHexToBrushConverter x:Key="HexToBrushConverter" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚙ Status State Manager" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="Configure status state colors, names, and 3D fill types." Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
        </DockPanel>

        <!-- Main Content Split -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: States List -->
            <Border Grid.Column="0" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                        <Button Content="+ Add State" Command="{Binding AddStateCommand}" Width="100" Margin="0,0,4,0" />
                        <Button Content="- Delete" Command="{Binding DeleteStateCommand}" Width="100" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,2" Background="#1f2937" CornerRadius="4">
                                    <DockPanel>
                                        <Border Width="16" Height="16" Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" CornerRadius="3" BorderBrush="#374151" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FillType}" DockPanel.Dock="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextMainBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right: State Detail Form -->
            <Border Grid.Column="2" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16" IsEnabled="{Binding HasSelectedState}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Edit Status Properties" Foreground="{StaticResource TextMainBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,12" />

                        <!-- ID -->
                        <TextBlock Text="State Identifier (ID)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding SelectedState.Id, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <!-- Display Name -->
                        <TextBlock Text="Display Name" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding SelectedState.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <!-- Color Hex Input & Preview -->
                        <TextBlock Text="Color (Hex Code)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding SelectedState.ColorHex, UpdateSourceTrigger=PropertyChanged}" />
                            <Border Grid.Column="2" Background="{Binding SelectedState.ColorHex, Converter={StaticResource HexToBrushConverter}}" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ToolTip="Live Color Preview" />
                        </Grid>

                        <!-- Quick Color Swatches Palette -->
                        <TextBlock Text="Quick Swatches" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding PaletteSwatches}" Margin="0,0,0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectColorSwatchCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="2" Padding="0" Width="24" Height="24" ToolTip="{Binding}">
                                        <Border Background="{Binding Converter={StaticResource HexToBrushConverter}}" CornerRadius="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Fill Type Toggle -->
                        <TextBlock Text="3D Viewport Fill Mode" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton Content="Solid Fill" IsChecked="{Binding SelectedState.IsSolid, Mode=TwoWay}" Foreground="{StaticResource TextMainBrush}" Margin="0,0,16,0" />
                            <RadioButton Content="Wireframe" IsChecked="{Binding SelectedState.IsWireframe, Mode=TwoWay}" Foreground="{StaticResource TextMainBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Validation Error Message Banner -->
        <Border Grid.Row="2" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" Background="#451a03" BorderBrush="#f59e0b" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,12">
            <TextBlock Text="{Binding ValidationError}" Foreground="#fbbf24" FontSize="11" FontWeight="SemiBold" />
        </Border>

        <!-- Footer Actions -->
        <DockPanel Grid.Row="3">
            <Button Content="Reset Defaults" Command="{Binding ResetDefaultsCommand}" DockPanel.Dock="Left" Padding="12,6" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="OnCancelClick" Padding="16,6" Margin="0,0,8,0" />
                <Button Content="Save &amp; Apply" Command="{Binding SaveCommand}" Background="#0284c7" Foreground="White" FontWeight="Bold" Padding="16,6" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
