<Window x:Class="UnitProgressTracker.Wpf.BomAddEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add 391- Entry" Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A" Foreground="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Add 391- Assembly Entry" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="Part Number" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,2" />
            <TextBox Text="{Binding PartNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="6,4" Background="#1E293B" Foreground="White" BorderBrush="#334155" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Skid" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,2" />
                    <ComboBox ItemsSource="{Binding AvailableSkids}" SelectedItem="{Binding SelectedSkid}" Padding="6,4" Background="#1E293B" Foreground="White" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Segment" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,2" />
                    <ComboBox ItemsSource="{Binding AvailableSegments}" SelectedItem="{Binding SelectedSegment}" Padding="6,4" Background="#1E293B" Foreground="White" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Description" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,2" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="6,4" Background="#1E293B" Foreground="White" BorderBrush="#334155" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Ext. Description" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,2" />
                    <TextBox Text="{Binding ExtDescription, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Background="#1E293B" Foreground="White" BorderBrush="#334155" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Quantity" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,2" />
                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Background="#1E293B" Foreground="White" BorderBrush="#334155" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancelClick" DockPanel.Dock="Right" Padding="16,6" Background="#334155" Foreground="White" BorderThickness="0" />
            <Button Content="Add Entry" Click="OnAddClick" DockPanel.Dock="Right" Padding="16,6" Margin="0,0,8,0" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" />
        </DockPanel>
    </Grid>
</Window>
