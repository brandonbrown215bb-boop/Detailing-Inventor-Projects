<Window x:Class="UnitProgressTracker.Wpf.RecentProjectsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recent Projects" Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A" Foreground="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Recent Projects" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
            <Button Content="Clear History" Click="OnClearHistoryClick" DockPanel.Dock="Right" Padding="8,4" Background="#334155" Foreground="White" BorderThickness="0" />
        </DockPanel>

        <ListBox x:Name="RecentListBox" Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" SelectionChanged="OnRecentSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="2" Background="#0F172A" CornerRadius="4" BorderBrush="#334155" BorderThickness="1">
                        <DockPanel>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" DockPanel.Dock="Top" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="#94A3B8" DockPanel.Dock="Top" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding LastOpened, StringFormat='Last opened: {0:g}'}" FontSize="10" Foreground="#64748B" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Close" Click="OnCloseClick" DockPanel.Dock="Right" Padding="16,6" Background="#334155" Foreground="White" BorderThickness="0" />
            <Button Content="Open Selected" Click="OnOpenSelectedClick" DockPanel.Dock="Right" Padding="16,6" Margin="0,0,8,0" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" />
        </DockPanel>
    </Grid>
</Window>
