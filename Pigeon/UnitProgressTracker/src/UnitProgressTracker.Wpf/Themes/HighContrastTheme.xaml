<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- High Contrast Tokens (WCAG AAA) -->
    <Color x:Key="BgDarkColor">#000000</Color>
    <Color x:Key="PanelBgColor">#000000</Color>
    <Color x:Key="HeaderBgColor">#1A1A1A</Color>
    <Color x:Key="CardBgColor">#000000</Color>
    <Color x:Key="InputBgColor">#000000</Color>
    <Color x:Key="TagBgColor">#1A1A1A</Color>
    <Color x:Key="HoverBgColor">#005A9E</Color>
    <Color x:Key="BorderColor">#FFFFFF</Color>
    <Color x:Key="AccentColor">#FFFF00</Color>
    <Color x:Key="TextMainColor">#FFFFFF</Color>
    <Color x:Key="TextMutedColor">#00FFFF</Color>
    <Color x:Key="BadgeTextColor">#FFFF00</Color>
    <Color x:Key="FocusOutlineColor">#00FFFF</Color>

    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}" />
    <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBgColor}" />
    <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}" />
    <SolidColorBrush x:Key="TagBgBrush" Color="{StaticResource TagBgColor}" />
    <SolidColorBrush x:Key="HoverBgBrush" Color="{StaticResource HoverBgColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextMainBrush" Color="{StaticResource TextMainColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="BadgeTextBrush" Color="{StaticResource BadgeTextColor}" />
    <SolidColorBrush x:Key="FocusOutlineBrush" Color="{StaticResource FocusOutlineColor}" />

</ResourceDictionary>
