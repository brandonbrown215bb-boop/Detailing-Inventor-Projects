<UserControl x:Class="QuestBoard.UI.Views.QuestDetailModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="700">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style x:Key="WaxButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#40000000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#90000000">
        <!-- Parchment Sheet Container -->
        <Border Width="700" MaxHeight="580" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#FDF5E6" BorderBrush="#8B4513" BorderThickness="3" CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="8" Color="Black" Opacity="0.7"/>
            </Border.Effect>
            
            <Grid Margin="16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Block -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <!-- Status Wax Stamp -->
                            <Border Background="{Binding SelectedQuest.SealBrush}" Padding="8,3" CornerRadius="4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding SelectedQuest.SealText}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            </Border>
                            <!-- Priority Tag -->
                            <Border Background="{Binding SelectedQuest.PriorityBrush}" Padding="8,3" CornerRadius="4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding SelectedQuest.PriorityUpper}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            </Border>
                            <TextBlock Text="{Binding SelectedQuest.Id}" Foreground="#8B4513" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <TextBlock Text="{Binding SelectedQuest.Title}" FontSize="18" FontWeight="Bold" Foreground="#3B2314" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedQuest.Owner, StringFormat='Owner: {0}'}" FontSize="12" Foreground="#5C3A21" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Close X Button -->
                    <Button Grid.Column="1" Click="CloseButton_Click" Width="30" Height="30" Content="✕" 
                            FontSize="16" FontWeight="Bold" Background="Transparent" Foreground="#8B4513" BorderThickness="0" Cursor="Hand"/>
                </Grid>

                <!-- Details & History Scrollable Parchment Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Next Action Section -->
                        <Border Background="#FFF8DC" BorderBrush="#D2B48C" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="🎯 NEXT ACTION" FontWeight="Bold" Foreground="#8B4513" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedQuest.NextAction}" FontSize="13" Foreground="#2C1A0E" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Context Section -->
                        <Border Background="#FFFDF5" BorderBrush="#DEB887" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="📜 CONTEXT &amp; BACKGROUND" FontWeight="Bold" Foreground="#8B4513" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedQuest.Context}" FontSize="12" Foreground="#3B2314" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Blocker Section if active -->
                        <Border Background="#FDEDEC" BorderBrush="#E74C3C" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8"
                                Visibility="{Binding SelectedQuest.HasBlocker, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="⚠️ BLOCKER REASON" FontWeight="Bold" Foreground="#C0392B" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedQuest.Blocker}" FontSize="12" Foreground="#922B21" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- History Section -->
                        <TextBlock Text="📜 HANDOFF LOG HISTORY" FontWeight="Bold" Foreground="#8B4513" FontSize="11" Margin="0,2,0,4"/>
                        <ItemsControl ItemsSource="{Binding SelectedQuest.Model.History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FAF0E6" BorderBrush="#D2B48C" BorderThickness="0,0,0,1" Padding="6" Margin="0,0,0,4">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Actor}" FontWeight="Bold" Foreground="#5C3A21" FontSize="11"/>
                                                <TextBlock Text=" · " Foreground="#8B4513"/>
                                                <TextBlock Text="{Binding Event}" Foreground="#8B4513" FontSize="10" FontWeight="SemiBold"/>
                                                <TextBlock Text=" · " Foreground="#8B4513"/>
                                                <TextBlock Text="{Binding FormattedTime}" Foreground="#8C6D58" FontSize="10"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Note}" Foreground="#3B2314" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Interactive Human Action Seals Bar -->
                <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Button Content="🛡️ Claim Quest" Background="#D4AF37" Style="{StaticResource WaxButtonStyle}" Click="ClaimButton_Click"/>
                    <Button Content="📜 Update / Handoff" Background="#B8860B" Style="{StaticResource WaxButtonStyle}" Click="HandoffButton_Click"/>
                    <Button Content="⚠️ Mark Blocked" Background="#C0392B" Style="{StaticResource WaxButtonStyle}" Click="BlockButton_Click"/>
                    <Button Content="🔵 Submit Review" Background="#2980B9" Style="{StaticResource WaxButtonStyle}" Click="ReviewButton_Click"/>
                    <Button Content="✅ Finish Quest" Background="#27AE60" Style="{StaticResource WaxButtonStyle}" Click="FinishButton_Click"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
