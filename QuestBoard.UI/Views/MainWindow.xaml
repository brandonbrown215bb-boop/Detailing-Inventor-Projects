<Window x:Class="QuestBoard.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:QuestBoard.UI.Views"
        mc:Ignorable="d"
        Title="Quest Board System" Height="780" Width="1040"
        Background="#2B1B0D"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="Left" Command="{Binding PreviousPageCommand}"/>
        <KeyBinding Key="Right" Command="{Binding NextPageCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <!-- Main Outer Container with Rich Wood Background -->
    <Border Background="#2B1B0D">
        <!-- Wooden Board Background Image Container -->
        <Grid>
            <!-- Background Texture Image (Questboard Template.jpg) -->
            <Image x:Name="BoardBackgroundImage" Stretch="Fill"/>

            <!-- Main Layout Grid -->
            <Grid Margin="20,15,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Wooden Header Plaque Bar -->
                    <RowDefinition Height="*"/>    <!-- Pinned Parchment Cards Canvas -->
                    <RowDefinition Height="Auto"/> <!-- Status Bar -->
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Human Actor Input -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚔️ QUEST BOARD" FontSize="22" FontWeight="Bold" Foreground="#FFF8DC" VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="2" Color="Black"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <Border Background="#FDF5E6" BorderBrush="#8B4513" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Actor: " Foreground="#5C3A21" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding ActorId, UpdateSourceTrigger=PropertyChanged}" Width="90" BorderThickness="0" Background="Transparent" Foreground="#3B2314" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Filter Tabs in Center -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <RadioButton Content="All Quests" IsChecked="True" Click="FilterTab_Click" Tag="All Quests" Style="{StaticResource {x:Type ToggleButton}}" Margin="3,0"/>
                        <RadioButton Content="Ready for Me" Click="FilterTab_Click" Tag="Ready for Me" Style="{StaticResource {x:Type ToggleButton}}" Margin="3,0"/>
                        <RadioButton Content="My Quests" Click="FilterTab_Click" Tag="My Active Quests" Style="{StaticResource {x:Type ToggleButton}}" Margin="3,0"/>
                        <RadioButton Content="Review Needed" Click="FilterTab_Click" Tag="Review Needed" Style="{StaticResource {x:Type ToggleButton}}" Margin="3,0"/>
                    </StackPanel>

                    <!-- Actions & Controls on Right -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📌 Post Quest" Click="PostQuest_Click" Background="#8B4513" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>
                        <Button x:Name="AudioToggleButton" Content="🔊" Click="AudioToggle_Click" Background="#D2B48C" Foreground="#3B2314" FontWeight="Bold" Width="32" Height="30" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- Central Corkboard: Pinned Parchment Cards Grid with Dynamic Pagination -->
                <Grid Grid.Row="1" x:Name="CorkboardContainer" Margin="115,25,115,30" SizeChanged="CorkboardContainer_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>    <!-- Cards Area -->
                        <RowDefinition Height="Auto"/> <!-- Wooden Pagination Bar -->
                    </Grid.RowDefinitions>

                    <!-- Cards Display Panel (Strictly bounded to corkboard) -->
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding QuestCards}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding Columns}" Rows="{Binding Rows}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Individual Pinned Parchment Card (Scaled down to fit inside inner corkboard boundaries) -->
                                <Border Width="200" Height="150" Margin="5" CornerRadius="4" Background="#FFFDF5" BorderBrush="#CD853F" BorderThickness="2" Cursor="Hand" MouseLeftButtonDown="QuestCard_MouseLeftButtonDown">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Color="Black" Opacity="0.4"/>
                                    </Border.Effect>

                                    <Border.LayoutTransform>
                                        <RotateTransform Angle="{Binding TiltAngle}"/>
                                    </Border.LayoutTransform>

                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}" Command="{Binding DataContext.SelectQuestCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Border.InputBindings>

                                    <Grid Margin="8,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Pushpin Visual Header -->
                                        <Grid Grid.Row="0" Margin="0,-4,0,3">
                                            <Ellipse Width="10" Height="10" Fill="#B22222" HorizontalAlignment="Center" VerticalAlignment="Top">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="2" ShadowDepth="1"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </Grid>

                                        <!-- Status Seal & Priority Badges -->
                                        <Grid Grid.Row="1" Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Wax Seal Badge -->
                                            <Border Grid.Column="0" Background="{Binding SealBrush}" HorizontalAlignment="Left" Padding="4,1" CornerRadius="3">
                                                <TextBlock Text="{Binding SealText}" Foreground="White" FontWeight="Bold" FontSize="9"/>
                                            </Border>

                                            <!-- Priority Tag -->
                                            <Border Grid.Column="1" Background="{Binding PriorityBrush}" HorizontalAlignment="Right" Padding="4,1" CornerRadius="3">
                                                <TextBlock Text="{Binding PriorityUpper}" Foreground="White" FontWeight="Bold" FontSize="9"/>
                                            </Border>
                                        </Grid>

                                        <!-- Title & Next Action Body -->
                                        <StackPanel Grid.Row="2">
                                            <TextBlock Text="{Binding Id}" FontSize="9" FontWeight="Bold" Foreground="#8B4513"/>
                                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold" Foreground="#2C1A0E" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="32" Margin="0,1,0,2"/>
                                            <TextBlock Text="{Binding NextAction, StringFormat='🎯 {0}'}" FontSize="9" Foreground="#5C3A21" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="24"/>
                                        </StackPanel>

                                        <!-- Footer: Owner info -->
                                        <Border Grid.Row="3" BorderBrush="#E6C280" BorderThickness="0,1,0,0" Padding="0,2,0,0" Margin="0,2,0,0">
                                            <Grid>
                                                <TextBlock Text="{Binding Owner, StringFormat='👤 {0}'}" FontSize="9" FontWeight="SemiBold" Foreground="#8B4513" HorizontalAlignment="Left"/>
                                                <TextBlock Text="Click to inspect 📜" FontSize="9" Foreground="#A0522D" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Wooden Pagination Control Bar at bottom of corkboard -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,2">
                        <!-- First Page Button -->
                        <Button Content="⏮" Command="{Binding FirstPageCommand}" Background="#8B4513" Foreground="#FFF8DC" FontWeight="Bold" Width="30" Height="28" Margin="3,0" Cursor="Hand" ToolTip="First Page"/>

                        <!-- Previous Page Arrow -->
                        <Button Content="◀" Command="{Binding PreviousPageCommand}" Background="#8B4513" Foreground="#FFF8DC" FontWeight="Bold" Width="38" Height="28" Margin="3,0" Cursor="Hand" ToolTip="Previous Page"/>

                        <!-- Parchment Page Indicator Badge -->
                        <Border Background="#FDF5E6" BorderBrush="#8B4513" BorderThickness="1.5" CornerRadius="4" Padding="12,4" Margin="6,0" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="2" Color="Black" Opacity="0.3"/>
                            </Border.Effect>
                            <TextBlock Text="{Binding PageInfoText}" Foreground="#3B2314" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Next Page Arrow -->
                        <Button Content="▶" Command="{Binding NextPageCommand}" Background="#8B4513" Foreground="#FFF8DC" FontWeight="Bold" Width="38" Height="28" Margin="3,0" Cursor="Hand" ToolTip="Next Page"/>

                        <!-- Last Page Button -->
                        <Button Content="⏭" Command="{Binding LastPageCommand}" Background="#8B4513" Foreground="#FFF8DC" FontWeight="Bold" Width="30" Height="28" Margin="3,0" Cursor="Hand" ToolTip="Last Page"/>
                    </StackPanel>
                </Grid>

                <!-- Status Bar -->
                <Border Grid.Row="2" Background="#40000000" CornerRadius="4" Padding="10,4" Margin="0,10,0,0">
                    <Grid>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#FFF8DC" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="Quest Board System v1.0" Foreground="#D2B48C" FontSize="11" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Modal Overlay Views -->
            <views:QuestDetailModal Visibility="{Binding IsDetailOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <views:CreateQuestDialog Visibility="{Binding IsCreateOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </Border>
</Window>
