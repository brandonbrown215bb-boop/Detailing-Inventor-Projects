<UserControl x:Class="UnitConstructionVerifier.UI.VerifierView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource BgPrimary}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnViewPreviewKeyDown">

    <UserControl.Resources>
        <!-- ── Palette ── -->
        <SolidColorBrush x:Key="BgPrimary"      Color="#191B22"/>
        <SolidColorBrush x:Key="BgSurface"      Color="#20232B"/>
        <SolidColorBrush x:Key="BgCard"         Color="#262A33"/>
        <SolidColorBrush x:Key="BgInput"        Color="#15171D"/>
        <SolidColorBrush x:Key="BgHover"        Color="#2A2F3B"/>
        <SolidColorBrush x:Key="BgSelected"     Color="#2D3550"/>
        <SolidColorBrush x:Key="BorderColor"    Color="#343946"/>
        <SolidColorBrush x:Key="BorderStrong"   Color="#4A5163"/>
        <SolidColorBrush x:Key="TextPrimary"    Color="#E7E9EF"/>
        <SolidColorBrush x:Key="TextSecondary"  Color="#98A0B1"/>
        <SolidColorBrush x:Key="AccentBlue"     Color="#7C9EFF"/>
        <SolidColorBrush x:Key="AccentGreen"    Color="#46C083"/>
        <SolidColorBrush x:Key="AccentRed"      Color="#F06872"/>
        <SolidColorBrush x:Key="AccentOrange"   Color="#E8A33D"/>
        <SolidColorBrush x:Key="AccentPending"  Color="#D9B44A"/>
        <SolidColorBrush x:Key="FailTint"       Color="#3A2228"/>
        <SolidColorBrush x:Key="PassTint"       Color="#1E3529"/>
        <SolidColorBrush x:Key="PendingTint"    Color="#3A3218"/>
        <SolidColorBrush x:Key="MutedTint"      Color="#2B2F39"/>

        <!-- Default control templates that fall back to system colours get dark values here. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#20232B"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E7E9EF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2D3550"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E7E9EF"/>
        <!-- No InactiveSelectionHighlight*BrushKey entries: Inventor runs WPF in .NET 4.0 compatibility, where
             those keys equal ControlBrushKey/ControlTextBrushKey and the duplicate key stops the window loading. -->


        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- "StatusBoard" (SurfaceStatusBoard) is added from code before this loads. -->

        <!-- ── Text ── -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="ColumnLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- ── Tooltip ── -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderStrong}"
                                BorderThickness="1" CornerRadius="4" Padding="8,5" MaxWidth="420">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Buttons ── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="#12141B"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="9,3"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                    <Setter Property="Background" Value="{StaticResource BgHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Check box, switch, segmented control, filter chips ── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="15" Height="15" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
                                <Path x:Name="Tick" Data="M 2.5 7 L 6 10.5 L 12 3.5" Stroke="#12141B" StrokeThickness="2"
                                      Visibility="Collapsed" Margin="-1,-1,0,0"/>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBlue}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Track" Width="32" Height="18" CornerRadius="9" Background="{StaticResource BorderColor}"
                                    BorderBrush="Transparent" BorderThickness="1" VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{StaticResource TextPrimary}"
                                         HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentPending}"/>
                                <Setter TargetName="Knob" Property="Margin" Value="16,0,0,0"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#1B1B1B"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="11,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgCard}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextSecondary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1" CornerRadius="11" Padding="10,2">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgCard}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextSecondary}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CountBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource MutedTint}"/>
        </Style>
        <Style x:Key="CountBadgeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>

        <!-- ── Text inputs ── -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Padding="0"/>
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource TextSecondary}"
                                           Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DataGridEditingTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentPending}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="3,1"/>
        </Style>

        <!-- ── Combo box ── -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,0,24,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Background="{TemplateBinding Background}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" Fill="{StaticResource TextSecondary}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource TextPrimary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderStrong}"
                                        BorderThickness="1" CornerRadius="5" Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="3" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Scroll bars ── -->
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="{StaticResource BorderStrong}" CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TextSecondary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" Margin="2,2"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" Margin="2,2"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Splitter ── -->
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Rectangle x:Name="Line" Width="1" Fill="{StaticResource BorderColor}" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Fill" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Menus ── -->
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderStrong}"
                                BorderThickness="1" CornerRadius="5" Padding="3">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="10,5" MinWidth="190">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgSelected}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorOptionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="SurfaceContextMenu">
            <MenuItem Header="Copy surface number" InputGestureText="Ctrl+C" Click="OnCopySurfaceNumberMenu"/>
            <MenuItem Header="Open in Inventor" Click="OnOpenSurfaceInInventor"/>
        </ContextMenu>
        <ContextMenu x:Key="PartContextMenu">
            <MenuItem Header="Copy part number" InputGestureText="Ctrl+C" Click="OnCopyPartNumberMenu"/>
            <MenuItem Header="Preview part" Click="OnWireframePreviewClick"/>
            <MenuItem Header="Open in Inventor" Click="OnOpenPartInInventor"/>
        </ContextMenu>
        <ContextMenu x:Key="OverflowMenu">
            <MenuItem Header="Save snapshot for regression tests…" Click="OnSaveSnapshot"/>
        </ContextMenu>

        <!-- ── Tabs ── -->
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Margin="12,0"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="12"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,0,0,2" Padding="14,10,14,8" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Surface list ── -->
        <Style x:Key="SurfaceItemStyle" TargetType="ListBoxItem">
            <Setter Property="ContextMenu" Value="{StaticResource SurfaceContextMenu}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="12,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{StaticResource BorderStrong}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFail}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AccentRed}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPass}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AccentGreen}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="SurfaceListItemTemplate">
            <Grid ToolTip="{Binding Segments, StringFormat='Segments: \{0\}'}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Style="{StaticResource StatusDot}">
                    <Ellipse.DataContext>
                        <MultiBinding Converter="{StaticResource StatusBoard}">
                            <Binding/>
                            <Binding Source="{StaticResource StatusBoard}" Path="Version"/>
                        </MultiBinding>
                    </Ellipse.DataContext>
                </Ellipse>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding PartNumber}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Segments, StringFormat='Segments \{0\}'}" Foreground="{StaticResource TextSecondary}"
                               Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                        Background="{StaticResource FailTint}"
                        Visibility="{Binding ShowBadge, Converter={StaticResource BoolToVisibility}}">
                    <Border.DataContext>
                        <MultiBinding Converter="{StaticResource StatusBoard}">
                            <Binding/>
                            <Binding Source="{StaticResource StatusBoard}" Path="Version"/>
                        </MultiBinding>
                    </Border.DataContext>
                    <TextBlock Text="{Binding Mismatches}" Style="{StaticResource CountBadgeText}" Foreground="{StaticResource AccentRed}"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ── Parts grid ── -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BgSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="0,0,0,1" Padding="10,7" SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                    <Path x:Name="SortArrow" Visibility="Collapsed" Margin="6,0,0,0" VerticalAlignment="Center"
                                          Fill="{StaticResource TextSecondary}" Data="M 0 4 L 4 0 L 8 4 Z"/>
                                </StackPanel>
                            </Border>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 4 4 L 8 0 Z"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="10,6" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgSelected}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PartRowStyle" TargetType="DataGridRow">
            <Setter Property="ContextMenu" Value="{StaticResource PartContextMenu}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNotChecked}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                    <Setter Property="Background" Value="{StaticResource FailTint}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditPending}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PendingTint}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReadOnlyCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="MonoCellText" TargetType="TextBlock" BasedOn="{StaticResource ReadOnlyCellText}">
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <!-- In part: the part's value, or "now → staged" while an edit is staged. Editing still edits the staged value. -->
        <DataTemplate x:Key="InPartCellTemplate">
            <TextBlock x:Name="InPartText" Text="{Binding InPartText}" Style="{StaticResource MonoCellText}" VerticalAlignment="Center"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditPending}" Value="True">
                    <Setter TargetName="InPartText" Property="Foreground" Value="{StaticResource AccentPending}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="InPartEditingTemplate">
            <TextBox Text="{Binding NewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DataGridEditingTextBox}"
                     FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"/>
        </DataTemplate>

        <!-- Status chip: colour and wording never depend on the row background. -->
        <DataTemplate x:Key="StatusCellTemplate">
            <Border x:Name="Chip" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left"
                    Background="{StaticResource PassTint}" ToolTip="{Binding StatusTooltip}">
                <TextBlock x:Name="ChipText" Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="11.5"
                           Foreground="{StaticResource AccentGreen}" TextTrimming="CharacterEllipsis"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource FailTint}"/>
                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource AccentRed}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNotChecked}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource MutedTint}"/>
                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource TextSecondary}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDisplayOnly}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource MutedTint}"/>
                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource TextSecondary}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditPending}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource PendingTint}"/>
                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource AccentPending}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="DescriptionCellTemplate">
            <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding DescriptionTooltip}">
                <Run Text="{Binding Description, Mode=OneWay}"/><Run Text="{Binding ReasonSuffix, Mode=OneWay}" Foreground="{StaticResource TextSecondary}"/>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Check banner -->
            <RowDefinition Height="*"/>     <!-- Tabs -->
            <RowDefinition Height="Auto"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ── Header: unit, overall status, highlight, edit switch ── -->
        <Border Grid.Row="0" Background="{StaticResource BgSurface}" Padding="16,10">
            <Grid x:Name="HeaderGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⬡" FontSize="20" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="IamPathLabel" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock Text="Unit Construction Verifier · checked live" Foreground="{StaticResource TextSecondary}" FontSize="11.5"/>
                    </StackPanel>
                    <Border x:Name="OverallStatusPill" CornerRadius="11" Padding="10,3" VerticalAlignment="Center"
                            Background="{StaticResource MutedTint}">
                        <TextBlock x:Name="OverallStatusText" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Text="Not scanned"/>
                    </Border>
                    <Border x:Name="NotCheckedPill" CornerRadius="11" Padding="10,3" Margin="6,0,0,0" VerticalAlignment="Center"
                            Background="{StaticResource MutedTint}" Visibility="Collapsed"
                            ToolTip="Parts a rule covers but that could not be checked. Use the Not checked filter on a surface to see why.">
                        <TextBlock x:Name="NotCheckedText" Foreground="{StaticResource TextSecondary}"/>
                    </Border>
                    <Button x:Name="NextIssueButton" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Visibility="Collapsed"
                            Click="OnNextIssueClick" ToolTip="Go to the next surface with a mismatch (F8)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Next issue"/>
                            <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="6,0,0,0">
                                <TextBlock Text="F8" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Highlight" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="{StaticResource BgInput}" CornerRadius="6" Padding="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="HighlightBoxRadio" GroupName="HighlightMode" Content="Box" IsChecked="True"
                                         Style="{StaticResource SegmentButton}" Checked="OnHighlightModeChanged"
                                         ToolTip="Colored locator box around the selected surface or part"/>
                            <RadioButton x:Name="HighlightXRayRadio" GroupName="HighlightMode" Content="X-Ray"
                                         Style="{StaticResource SegmentButton}" Checked="OnHighlightModeChanged"
                                         ToolTip="Detailed edge outline of the selected part within its surface"/>
                            <RadioButton x:Name="HighlightOffRadio" GroupName="HighlightMode" Content="Off"
                                         Style="{StaticResource SegmentButton}" Checked="OnHighlightModeChanged"
                                         ToolTip="No verifier highlight; Inventor's normal green selection is restored"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="XRayColorButton" Width="20" Height="20" Margin="8,0,0,0" VerticalAlignment="Center"
                            Click="OnXRayColorButtonClick" ToolTip="Highlight color" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Swatch" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderStrong}"
                                        BorderThickness="1" CornerRadius="10"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Swatch" Property="BorderBrush" Value="{StaticResource TextPrimary}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Popup x:Name="XRayColorPopup" PlacementTarget="{Binding ElementName=XRayColorButton}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"
                                CornerRadius="6" Padding="4" Margin="0,4,0,0">
                            <StackPanel x:Name="XRayColorListPanel"/>
                        </Border>
                    </Popup>

                    <Rectangle Width="1" Height="20" Fill="{StaticResource BorderColor}" Margin="16,0"/>

                    <CheckBox x:Name="EditModeCheckBox" Style="{StaticResource SwitchCheckBox}" Content="Edit parts"
                              Checked="OnEditModeChanged" Unchecked="OnEditModeChanged"
                              ToolTip="Stage changes to part properties, then write them to the IPT files"/>
                    <Button x:Name="DockToggleButton" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Visibility="Collapsed"
                            Content="Dock" Click="OnDockToggleClick"/>
                </WrapPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1">
            <!-- ── Inventor moved to another unit than the one being checked ── -->
            <Border x:Name="OtherUnitBanner" Margin="12,10,12,0" CornerRadius="6" Padding="12,7"
                    Background="{StaticResource PendingTint}" BorderBrush="{StaticResource AccentPending}" BorderThickness="1" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="✕" Click="OnCloseOtherUnitBannerClick"
                            ToolTip="Keep checking this unit"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Check this unit" Margin="0,0,8,0"
                            Click="OnCheckActiveUnitClick" ToolTip="Close this check (asks about unsaved changes) and check the unit open in Inventor"/>
                    <TextBlock x:Name="OtherUnitText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource AccentPending}"/>
                </DockPanel>
            </Border>

            <!-- ── Re-check summary ── -->
            <Border x:Name="CheckBanner" Margin="12,10,12,0" CornerRadius="6" Padding="12,7"
                    Background="{StaticResource FailTint}" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="✕" Click="OnCloseBannerClick" ToolTip="Dismiss"/>
                    <Button x:Name="BannerNextIssueButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Go to first issue"
                            Margin="0,0,8,0" Click="OnNextIssueClick"/>
                    <TextBlock x:Name="CheckBannerText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ── Surface tabs ── -->
        <TabControl x:Name="MainTabControl" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="OnMainTabChanged">

            <!-- ROOF -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Roof"/>
                        <Border x:Name="RoofTabBadge" Style="{StaticResource CountBadge}" Margin="8,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="RoofTabBadgeText" Style="{StaticResource CountBadgeText}"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Background="{StaticResource BgSurface}">
                    <Grid x:Name="RoofBody">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" MinWidth="170" MaxWidth="420"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <TextBox x:Name="RoofSearchBox" DockPanel.Dock="Top" Style="{StaticResource FormTextBox}" Margin="10"
                                     Tag="Find surface or part…" TextChanged="OnSurfaceSearchChanged"/>
                            <ListBox x:Name="RoofSurfaceList" Background="Transparent" BorderThickness="0"
                                     SelectionChanged="OnRoofSelectionChanged" PreviewMouseLeftButtonDown="OnSurfaceListPreviewMouseDown"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemTemplate="{StaticResource SurfaceListItemTemplate}" ItemContainerStyle="{StaticResource SurfaceItemStyle}"/>
                        </DockPanel>
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ShowsPreview="False"/>

                        <Grid Grid.Column="2" Background="{StaticResource BgPrimary}">
                            <Grid x:Name="RoofDetailPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="16,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Copy to all roofs…" Style="{StaticResource SmallButton}" Click="OnApplyRoofToAll"
                                                    ToolTip="Replace the expectations of every other roof with these values"/>
                                            <ToggleButton x:Name="RoofSpecToggle" IsChecked="True" HorizontalAlignment="Left" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                                            <TextBlock x:Name="Chev" Text="▾" Foreground="{StaticResource TextSecondary}" Width="14" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Expected construction" Style="{StaticResource SectionHeader}"/>
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="False">
                                                                <Setter TargetName="Chev" Property="Text" Value="▸"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </DockPanel>
                                        <Grid x:Name="RoofSpecGrid" Margin="14,10,0,0" Visibility="{Binding IsChecked, ElementName=RoofSpecToggle, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="32"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Column="1" Text="GAUGE" Style="{StaticResource ColumnLabel}"/>
                                            <TextBlock Grid.Column="2" Text="MATERIAL" Style="{StaticResource ColumnLabel}" Margin="6,0,0,2"/>
                                            <TextBlock Grid.Column="5" Text="GAUGE" Style="{StaticResource ColumnLabel}"/>
                                            <TextBlock Grid.Column="6" Text="MATERIAL" Style="{StaticResource ColumnLabel}" Margin="6,0,0,2"/>

                                            <TextBlock Grid.Row="1" Text="Exterior skin" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="RoofExteriorGaugeCombo" SelectionChanged="OnRoofExpectationsChanged" TabIndex="10"/>
                                            <ComboBox Grid.Row="1" Grid.Column="2" x:Name="RoofExteriorMaterialCombo" SelectionChanged="OnRoofExpectationsChanged" Margin="6,0,0,0" TabIndex="11"/>
                                            <TextBlock Grid.Row="1" Grid.Column="4" Text="Interior liner" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Grid.Row="1" Grid.Column="5" x:Name="RoofInteriorGaugeCombo" SelectionChanged="OnRoofExpectationsChanged" TabIndex="12"/>
                                            <ComboBox Grid.Row="1" Grid.Column="6" x:Name="RoofInteriorMaterialCombo" SelectionChanged="OnRoofExpectationsChanged" Margin="6,0,0,0" TabIndex="13"/>

                                            <TextBlock Grid.Row="2" Text="Channel" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="RoofChannelGaugeCombo" SelectionChanged="OnRoofExpectationsChanged" TabIndex="14"/>
                                            <ComboBox Grid.Row="2" Grid.Column="2" x:Name="RoofChannelMaterialCombo" SelectionChanged="OnRoofExpectationsChanged" Margin="6,0,0,0" TabIndex="15"/>
                                            <TextBlock Grid.Row="2" Grid.Column="4" Text="Trim" Style="{StaticResource FieldLabel}"
                                                       ToolTip="Roof trim: roof caps and roof corner caps (091-30117-001/058/074). ALM EMB is always 20 GA."/>
                                            <ComboBox Grid.Row="2" Grid.Column="5" x:Name="RoofTrimGaugeCombo" SelectionChanged="OnRoofExpectationsChanged" TabIndex="16"/>
                                            <ComboBox Grid.Row="2" Grid.Column="6" x:Name="RoofTrimMaterialCombo" SelectionChanged="OnRoofExpectationsChanged" Margin="6,0,0,0" TabIndex="17"/>

                                            <TextBlock Grid.Row="3" Text="Panel thickness" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="RoofThicknessText" Style="{StaticResource FormTextBox}" Width="60" HorizontalAlignment="Left"
                                                     TextChanged="OnRoofExpectationsChanged" TabIndex="18"/>
                                            <TextBlock Grid.Row="3" Grid.Column="4" Text="Insulation" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Grid.Row="3" Grid.Column="5" Grid.ColumnSpan="2" x:Name="RoofInsulationText" Style="{StaticResource FormTextBox}"
                                                     TextChanged="OnRoofExpectationsChanged" TabIndex="19"/>

                                            <TextBlock Grid.Row="4" Text="Thermal break" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="RoofThermalCombo" SelectionChanged="OnRoofThermalComboChanged" TabIndex="20"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="1" Margin="16,10,16,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,8">
                                        <WrapPanel x:Name="RoofPartsActions" DockPanel.Dock="Right" Orientation="Horizontal">
                                            <StackPanel x:Name="RoofSyncButtonsPanel" Orientation="Horizontal" Visibility="Collapsed">
                                                <Button Content="Use expected for selected" Style="{StaticResource SmallButton}" Margin="0,0,6,0" Click="OnSyncSelectedRoof"/>
