                            <TextBlock x:Name="WallPlaceholderText" TextWrapping="Wrap" TextAlignment="Center" Margin="16" Text="Select a wall surface to check its parts, or press F8 to jump to the next issue." Foreground="{StaticResource TextSecondary}"
