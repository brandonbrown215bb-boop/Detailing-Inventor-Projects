                                            <ComboBox Grid.Row="2" Grid.Column="2" x:Name="WallChannelMaterialCombo" SelectionChanged="OnWallExpectationsChanged" Margin="6,0,0,0" TabIndex="35"/>
                                            <TextBlock Grid.Row="2" Grid.Column="4" Text="Paint style" Style="{StaticResource FieldLabel}"/>
