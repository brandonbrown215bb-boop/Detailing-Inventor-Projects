                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="32"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="GAUGE" Style="{StaticResource ColumnLabel}" Margin="0,6,0,2"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="MATERIAL" Style="{StaticResource ColumnLabel}" Margin="6,6,0,2"/>
                                            <TextBlock Grid.Row="1" Grid.Column="5" Text="GAUGE" Style="{StaticResource ColumnLabel}" Margin="0,6,0,2"/>
                                            <TextBlock Grid.Row="1" Grid.Column="6" Text="MATERIAL" Style="{StaticResource ColumnLabel}" Margin="6,6,0,2"/>

                                            <TextBlock Grid.Row="0" Text="Base height" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="BaseHeightCombo" SelectionChanged="OnBaseExpectationsComboChanged" TabIndex="50"/>
                                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Base structure" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="2" x:Name="BaseMatCombo" SelectionChanged="OnBaseExpectationsComboChanged" TabIndex="51"/>

                                            <TextBlock Grid.Row="2" Text="Formed channel" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="FormedChannelGaugeCombo" SelectionChanged="OnBaseExpectationsComboChanged" TabIndex="52"/>
                                            <ComboBox Grid.Row="2" Grid.Column="2" x:Name="FormedChannelMaterialCombo" SelectionChanged="OnBaseExpectationsComboChanged" Margin="6,0,0,0" TabIndex="53"/>
                                            <TextBlock Grid.Row="2" Grid.Column="4" Text="Floor" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Grid.Row="2" Grid.Column="5" x:Name="FloorGaugeCombo" SelectionChanged="OnBaseExpectationsComboChanged" TabIndex="54"/>
                                            <ComboBox Grid.Row="2" Grid.Column="6" x:Name="FloorMaterialCombo" SelectionChanged="OnBaseExpectationsComboChanged" Margin="6,0,0,0" TabIndex="55"/>

                                            <TextBlock Grid.Row="3" Text="Sub-floor" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="SubFloorGaugeCombo" SelectionChanged="OnBaseExpectationsComboChanged" TabIndex="56"/>
                                            <ComboBox Grid.Row="3" Grid.Column="2" x:Name="SubFloorMaterialCombo" SelectionChanged="OnBaseExpectationsComboChanged" Margin="6,0,0,0" TabIndex="57"/>
                                            <TextBlock Grid.Row="3" Grid.Column="4" Text="Perimeter angle" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Grid.Row="3" Grid.Column="5" x:Name="PerimeterAngleGaugeCombo" SelectionChanged="OnBaseExpectationsComboChanged" TabIndex="58"/>
                                            <ComboBox Grid.Row="3" Grid.Column="6" x:Name="PerimeterAngleMaterialCombo" SelectionChanged="OnBaseExpectationsComboChanged" Margin="6,0,0,0" TabIndex="59"/>

                                            <TextBlock Grid.Row="4" Text="Floor thermal break" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="FloorThermalCombo" SelectionChanged="OnFloorThermalComboChanged" TabIndex="60"/>

                                            <TextBlock Grid.Row="5" Grid.ColumnSpan="7" Text="UNIT (APPLIES TO ALL BASES)" Style="{StaticResource ColumnLabel}" Margin="0,10,0,2"/>
                                            <CheckBox Grid.Row="6" x:Name="LipCheckBox" Content="Upturned lip" Checked="OnLipCheckChanged" Unchecked="OnLipCheckChanged" TabIndex="61"/>
                                            <TextBox Grid.Row="6" Grid.Column="1" x:Name="LipHeightBox" Style="{StaticResource FormTextBox}" Width="60" HorizontalAlignment="Left"
                                                     Tag="height" TextChanged="OnLipHeightChanged" TabIndex="62"/>
                                            <CheckBox Grid.Row="6" Grid.Column="4" x:Name="CurbCheckBox" Content="Curb rest" Checked="OnCurbCheckChanged" Unchecked="OnCurbCheckChanged" TabIndex="63"/>
                                            <TextBox Grid.Row="6" Grid.Column="5" x:Name="CurbHeightBox" Style="{StaticResource FormTextBox}" Width="60" HorizontalAlignment="Left"
                                                     Tag="height" TextChanged="OnCurbHeightChanged" TabIndex="64"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="1" Margin="16,10,16,14">
