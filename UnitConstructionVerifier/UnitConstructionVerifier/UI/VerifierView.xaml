            <!-- BASE & FLOOR -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Base &amp; Floor"/>
                        <Border x:Name="BaseTabBadge" Style="{StaticResource CountBadge}" Margin="8,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="BaseTabBadgeText" Style="{StaticResource CountBadgeText}"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Background="{StaticResource BgSurface}">
                    <Grid x:Name="BaseBody">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" MinWidth="170" MaxWidth="420"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <TextBox x:Name="BaseSearchBox" DockPanel.Dock="Top" Style="{StaticResource FormTextBox}" Margin="10"
                                     Tag="Find surface or part…" TextChanged="OnSurfaceSearchChanged"/>
                            <ListBox x:Name="BaseSurfaceList" Background="Transparent" BorderThickness="0"
                                     SelectionChanged="OnBaseSelectionChanged" PreviewMouseLeftButtonDown="OnSurfaceListPreviewMouseDown"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemTemplate="{StaticResource SurfaceListItemTemplate}" ItemContainerStyle="{StaticResource SurfaceItemStyle}"/>
                        </DockPanel>
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ShowsPreview="False"/>

                        <Grid Grid.Column="2" Background="{StaticResource BgPrimary}">
