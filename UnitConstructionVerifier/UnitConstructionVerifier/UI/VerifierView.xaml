                                            <DataGridTemplateColumn Header="Description" CellTemplate="{StaticResource DescriptionCellTemplate}" SortMemberPath="Description" Width="2*" MinWidth="130"/>
                                            <DataGridTextColumn Header="Type" Binding="{Binding PartType}" ElementStyle="{StaticResource ReadOnlyCellText}" IsReadOnly="True" Width="0.8*" MinWidth="70"/>
                                            <DataGridTextColumn Header="Checks" Binding="{Binding Parameter}" ElementStyle="{StaticResource ReadOnlyCellText}" IsReadOnly="True" Width="1.4*" MinWidth="100"/>
                                            <DataGridTextColumn Header="Expected" Binding="{Binding Expected}" ElementStyle="{StaticResource MonoCellText}" IsReadOnly="True" Width="1.4*" MinWidth="110"/>
