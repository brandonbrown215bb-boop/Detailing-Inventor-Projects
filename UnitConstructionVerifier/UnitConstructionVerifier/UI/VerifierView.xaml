                                    <DataGrid Grid.Row="1" x:Name="WallPartsGrid" RowStyle="{StaticResource PartRowStyle}"
                                              SelectionChanged="OnPartsGridSelectionChanged" BeginningEdit="OnPartsGridBeginningEdit"
                                              PreviewMouseLeftButtonDown="OnPartsGridPreviewMouseDown">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Status" CellTemplate="{StaticResource StatusCellTemplate}" SortMemberPath="StatusText" Width="118" MinWidth="104"/>
                                            <DataGridTextColumn Header="Part" Binding="{Binding PartNumber}" ElementStyle="{StaticResource MonoCellText}" IsReadOnly="True" Width="SizeToCells" MinWidth="140"/>
                                            <DataGridTemplateColumn Header="Description" CellTemplate="{StaticResource DescriptionCellTemplate}" SortMemberPath="Description" Width="2*" MinWidth="130"/>
