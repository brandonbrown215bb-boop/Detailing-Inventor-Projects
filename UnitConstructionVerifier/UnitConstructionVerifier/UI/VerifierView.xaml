                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ── Footer ── -->
        <Border Grid.Row="3" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,9">
            <Grid x:Name="FooterGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="EditModeFooterPanel" Background="{StaticResource PendingTint}" BorderBrush="{StaticResource AccentPending}"
                            BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,12,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StagedEditsText" Text="No part changes staged" Foreground="{StaticResource AccentPending}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="Discard" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="OnCancelChanges"/>
                            <Button Content="Review &amp; write to parts…" Style="{StaticResource PrimaryButton}" Padding="12,4"
                                    Background="{StaticResource AccentPending}" Click="OnWriteChanges"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="UnsavedOverridesLabel" Text="● Unsaved expectation changes" Foreground="{StaticResource AccentOrange}"
                               VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"
                               ToolTip="Click Save expectations to keep these changes for this unit"/>
                    <TextBlock x:Name="NoticeText" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </WrapPanel>

                <StackPanel Grid.Column="1" x:Name="NormalModeFooterPanel" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="OverflowButton" Content="⋯" Style="{StaticResource GhostButton}" FontSize="14" Padding="10,2" Margin="0,0,6,0"
                            Click="OnOverflowClick" ToolTip="More"/>
                    <Button Content="Save expectations" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnSave"
                            ToolTip="Keep expectation changes for this unit (saved next to the IAM)"/>
                    <Button Content="Re-check unit" Style="{StaticResource PrimaryButton}" Click="OnVerify"
                            ToolTip="Run every check again and summarize the result"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress while part files are written and the unit re-scanned. Blocks input; the view underneath stays as it was
             (disabling the whole view turned the surface lists white and greyed everything, which looked broken). -->
        <Grid x:Name="BusyOverlay" Grid.RowSpan="4" Panel.ZIndex="11" Background="#B30C0D12" Visibility="Collapsed">
            <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="8"
                    MaxWidth="460" Margin="16" Padding="18,14" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="BusyTitle" Text="Writing part changes…" Style="{StaticResource SectionHeader}" FontSize="15"/>
                    <TextBlock x:Name="BusyDetail" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                    <ProgressBar x:Name="BusyProgress" Height="6" Minimum="0" Maximum="1" Foreground="{StaticResource AccentPending}"
                                 Background="{StaticResource BgInput}" BorderThickness="0"/>
                    <TextBlock Text="Inventor opens, updates and saves each part in turn, so this can take a while on many parts."
                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11.5"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Write review: every staged change; untick to leave it staged. Covers the window until Write or Cancel. -->
        <Grid x:Name="WriteReviewOverlay" Grid.RowSpan="4" Panel.ZIndex="10" Background="#B30C0D12" Visibility="Collapsed">
            <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="8"
                    MaxWidth="820" MaxHeight="560" Margin="16" Padding="18,14" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    KeyboardNavigation.TabNavigation="Cycle">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Review part changes" Style="{StaticResource SectionHeader}" FontSize="15"/>
                        <TextBlock x:Name="WriteReviewSummary" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                        <Grid Margin="8,0,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Part" Style="{StaticResource ColumnLabel}"/>
                            <TextBlock Grid.Column="2" Text="Property" Style="{StaticResource ColumnLabel}"/>
                            <TextBlock Grid.Column="3" Text="Now" Style="{StaticResource ColumnLabel}"/>
                            <TextBlock Grid.Column="5" Text="Will be" Style="{StaticResource ColumnLabel}"/>
                        </Grid>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="True">
                        <Button x:Name="WriteReviewConfirmButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="14,5"
                                Background="{StaticResource AccentPending}" Content="Write changes" Click="OnWriteReviewConfirm"/>
                        <Button x:Name="WriteReviewCancelButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                Content="Cancel" IsCancel="True" Click="OnWriteReviewCancel"/>
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,12,0"
                                   Text="Part files must be checked out of Vault. Ticked changes are written in one transaction."/>
                    </DockPanel>
                    <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="WriteReviewList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="ReviewRow" Margin="8,0" MinHeight="30">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="1.3*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}" IsEnabled="{Binding CanWrite}" VerticalAlignment="Center"
                                                      ToolTip="Untick to leave this change staged"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PartNumber}" ToolTip="{Binding FileTooltip}" FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Parameter}" Style="{StaticResource ReadOnlyCellText}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Current}" Style="{StaticResource MonoCellText}"
                                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="→" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="NewText" Grid.Column="5" Text="{Binding NewValue}" ToolTip="{Binding NewValueTooltip}" FontFamily="Consolas"
                                                       Foreground="{StaticResource AccentPending}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                                <Setter TargetName="ReviewRow" Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CanWrite}" Value="False">
                                                <Setter TargetName="NewText" Property="TextDecorations" Value="Strikethrough"/>
                                                <Setter TargetName="NewText" Property="Foreground" Value="{StaticResource AccentRed}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
