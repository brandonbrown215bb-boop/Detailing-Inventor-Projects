<Window x:Class="UnitConstructionVerifier.UI.PartPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Part Wireframe Preview"
        Width="520" Height="440" MinWidth="360" MinHeight="320"
        WindowStartupLocation="Manual"
        Background="#1E1E2E">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleLabel"
                       Grid.Column="0"
                       Foreground="#F8F8F2"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button x:Name="PreviewColorButton"
                    Grid.Column="1"
                    Width="22"
                    Height="22"
                    Padding="0"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Click="OnPreviewColorButtonClick"
                    ToolTip="Wireframe color">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PreviewSwatchBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#44445A"
                                BorderThickness="1"
                                CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PreviewSwatchBorder" Property="BorderBrush" Value="#7C9EFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Popup x:Name="PreviewColorPopup"
                   PlacementTarget="{Binding ElementName=PreviewColorButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="#2A2A3E"
                        BorderBrush="#44445A"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="4">
                    <StackPanel x:Name="PreviewColorListPanel"/>
                </Border>
            </Popup>
        </Grid>

        <Border Grid.Row="1"
                Background="#12121A"
                BorderBrush="#44445A"
                BorderThickness="1"
                CornerRadius="6"
                ClipToBounds="True">
            <Canvas x:Name="WireCanvas"
                    Background="Transparent"
                    Focusable="True"
                    MouseDown="OnCanvasMouseDown"
                    MouseMove="OnCanvasMouseMove"
                    MouseUp="OnCanvasMouseUp"
                    MouseWheel="OnCanvasMouseWheel"/>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,8,0,0"
                   Foreground="#AAAACC"
                   FontSize="11"
                   Text="Drag: rotate · Wheel: zoom · Middle-drag: pan · Updates when surface/part selection changes"/>
    </Grid>
</Window>
